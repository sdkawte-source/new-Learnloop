<%- include('partials/header') %>

<section class="page-hero">
  <p class="eyebrow">Privacy</p>
  <h1>Privacy Policy</h1>
</section>

<section class="article-page" style="padding-top: 0;">
  <div class="article-section">
    <h2>What We Collect</h2>
    <p>When you register on LearnLoop, we collect your full name, email address, phone number (optional), city, the skill you want to learn, the skill you can teach (if any), and your chosen plan (Free or Pro).</p>
  </div>
  <div class="article-section">
    <h2>How We Use It</h2>
    <ul class="bullet-list">
      <li>To match you with a suitable mentor or learner</li>
      <li>To send you a registration confirmation email and occasional updates about your swaps or courses</li>
      <li>To improve LearnLoop based on which skills and plans are most requested</li>
    </ul>
  </div>
  <div class="article-section">
    <h2>What We Don't Do</h2>
    <p>We never sell your registration data to third parties. Your email and phone number are only shared with a matched mentor or learner with your knowledge.</p>
  </div>
  <div class="article-section">
    <h2>Requesting Deletion</h2>
    <p>You can request that your data be removed at any time by emailing <a href="mailto:safety@learnloop.community">safety@learnloop.community</a> with your registration ID (sent to you in your confirmation email).</p>
  </div>
</section>

<%- include('partials/footer') %>
